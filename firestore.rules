rules_version = '2';

// Dhaka Salon — Firestore Security Rules
//
// Replace YOUR_ADMIN_UID below with the Firebase Auth UID of the single
// admin account (Firebase console → Authentication → Users, after you
// create that account's email/password login). This same UID must also
// be set as ADMIN_UID in admin/index.html.
//
// Paste this whole file into: Firebase console → Firestore Database → Rules.

service cloud.firestore {
  match /databases/{database}/documents {

    match /playlist/{songId} {
      // Public visitors: can only read songs marked active.
      // The admin (signed in, matching UID): can read everything,
      // including disabled songs, so the admin panel can manage them.
      allow read: if (resource.data.active == true)
                  || (request.auth != null && request.auth.uid == "YOUR_ADMIN_UID");

      // Only the admin account may add, edit, delete, or reorder songs.
      allow create, update, delete: if request.auth != null
                                     && request.auth.uid == "YOUR_ADMIN_UID";
    }

    // Everything else stays locked down by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
